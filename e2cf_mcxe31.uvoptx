        <tDlgPa></tDlgPa>
        <tIfile></tIfile>
        <pMon>BIN\CMSIS_AGDI.dll</pMon>
      </DebugOpt>
      <TargetDriverDllRegistry>
        <SetRegEntry>
          <Number>0</Number>
          <Key>CMSIS_AGDI</Key>
          <Name>-X"CMSIS-DAP v1" -UCDAB781EC4BC -O206 -S8 -C0 -P00000004 -N00("ARM CoreSight SW-DP") -D00(6BA02477) -L00(0) -TO65554 -TC10000000 -TT10000000 -TP20 -TDS8007 -TDT0 -TDC1F -TIEFFFFFFFF -TIP8 -FO7 -FD20400000 -FC8000 -FN2 -FF0MCXE31x_Code.FLM -FS0400000 -FL0400000 -FP0($$Device:MCXE31BMPB$devices\MCXE31B\arm\MCXE31x_Code.FLM) -FF1MCXE31x_Data.FLM -FS110000000 -FL120000 -FP1($$Device:MCXE31BMPB$devices\MCXE31B\arm\MCXE31x_Data.FLM)</Name>
        </SetRegEntry>
        <SetRegEntry>
          <Number>0</Number>
          <Key>UL2CM3</Key>
          <Name>-U -O206 -S8 -C0 -P04 -N00("") -D00(00000000) -L00(0) -TO65554 -TC10000000 -TT10000000 -TP21 -TDS8007 -TDT0 -TDC1F -TIEFFFFFFFF -TIP8 -FO7 -FD20400000 -FC8000 -FN2 -FF0MCXE31x_Code.FLM -FS0400000 -FL0400000 -FP0($$Device:MCXE31BMPB$devices\MCXE31B\arm\MCXE31x_Code.FLM) -FF1MCXE31x_Data.FLM -FS110000000 -FL120000 -FP1($$Device:MCXE31BMPB$devices\MCXE31B\arm\MCXE31x_Data.FLM)</Name>
        </SetRegEntry>
      </TargetDriverDllRegistry>
      <Breakpoint/>
      <Tracepoint>
        <THDelay>0</THDelay>
      </Tracepoint>
      <DebugFlag>
        <trace>0</trace>
        <periodic>0</periodic>
        <aLwin>0</aLwin>
